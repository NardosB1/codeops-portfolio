# Neon connection string (Neon Console -> Project -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Generate with: openssl rand -base64 32. Keep this secret and rotate if exposed.
# .env.example
SESSION_SECRET=generate-with-node-crypto-randomBytes-32-base64
# Set to true only behind HTTPS in production
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
